#!/bin/sh

changed=0

if ! uci -q get "luci.themes.Liquid" 2>/dev/null; then
	uci set "luci.themes.Liquid=/luci-static/liquid"
	changed=1
fi

if [ "$PKG_UPGRADE" != 1 ] && [ $changed = 1 ]; then
	if ! uci -q get "luci.main.mediaurlbase" 2>/dev/null; then
		uci set "luci.main.mediaurlbase=/luci-static/liquid"
	fi
fi

if [ $changed = 1 ]; then
	uci commit luci
fi

# 主题持久化配置（模式/主题色/Bing 壁纸开关）：首次安装时创建默认 section
if [ ! -f /etc/config/liquid ]; then
	touch /etc/config/liquid
	uci set "liquid.theme=theme"
	uci commit liquid
fi

exit 0
