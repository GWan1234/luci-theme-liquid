{%
	const boardinfo = ubus.call('system', 'board') ?? {};
%}

{% if (!blank_page): %}
	</div><!-- /#maincontent -->
</div><!-- /#maincontainer -->
{% endif %}

{% if (blank_page): %}
<p class="luci">
	<a href="https://github.com/zzsj0928/luci-theme-liquid" target="_blank" rel="noopener">Liquid Theme {# PKG_VERSION #}</a><br>
	<a href="https://github.com/openwrt/openwrt/releases" target="_blank" rel="noopener">{{ version.distversion }} {{ version.distrevision }}</a><br>
	Kernel: {{ boardinfo.kernel ?? '?' }}<br>
	<a href="https://github.com/openwrt/luci/releases" target="_blank" rel="noopener">{{ version.luciname }} {{ version.luciversion }}</a>
</p>
{% endif %}
{% if (!blank_page): %}
<p class="luci">
	Powered by {{ version.luciname }} ({{ version.luciversion }})
</p>
{% endif %}

{% if (!blank_page): %}
<script>L.require('menu-liquid')</script>
{% endif %}
<script type="text/javascript" src="{{ media }}/main.js"></script>

</body>
</html>
